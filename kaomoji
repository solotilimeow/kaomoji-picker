custom="${XDG_CONFIG_HOME:-$HOME/.config}/kaomoji.txt"

if [ ! -f "$custom" ]; then
    mkdir -p "$(dirname "$custom")"
    echo "# Your own kaomoji: the kaomoji, then 3 spaces, then search words" > "$custom"
fi

