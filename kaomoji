choice=$( { cat "$custom"; builtin_list; } \
    | grep -Ev '^[[:space:]]*(#|$)' \
    | awk '{ k = $0; sub(/ {3,}.*$/, "", k); if (!seen[k]++) print }' \
    | fuzzel --dmenu --match-mode exact --no-sort \
        --prompt "kaomoji › " --width 50 --lines 12 ) || exit 0

kaomoji=$(printf '%s' "$choice" | sed -E 's/ {3,}.*$//')
[ -n "$kaomoji" ] || exit 0

printf '%s' "$kaomoji" | wl-copy
if command -v notify-send >/dev/null; then
    notify-send -a Kaomoji -t 1500 "Copied, press Ctrl+V" "$kaomoji"
fi
